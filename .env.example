# URL endpoint MockAPI / REST untuk data request
VITE_API_URL=https://6ae305fe933120ae20f80e32.mockapi.io/requests

# URL endpoint master PIC. Jika kosong, otomatis diturunkan dari VITE_API_URL
# dengan mengganti /requests menjadi /pics.
VITE_PIC_API_URL=

# Kredensial login admin (hanya untuk pembatasan UI, bukan keamanan server)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=admin123

# Supabase Storage untuk lampiran (WAJIB di Vercel, karena disk Vercel tidak permanen).
# Ambil dari Supabase Dashboard -> Project Settings -> API. Anon key memang publik.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=attachments

# Provider upload: supabase, cloudinary, atau local (server Express).
# Kosongkan agar dipilih otomatis: supabase jika VITE_SUPABASE_* diisi,
# lalu cloudinary jika kredensialnya diisi, selain itu local.
VITE_UPLOAD_PROVIDER=

# Endpoint upload lokal dari frontend. Default /api/uploads (same-origin / proxy Vite).
# Isi URL lengkap jika frontend dan server upload berada di origin berbeda.
VITE_UPLOAD_URL=/api/uploads

# Kredensial publik Cloudinary (bukan API secret). Isi jika memakai provider cloudinary.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Konfigurasi server upload (dibaca oleh server/index.js, bukan Vite)
PORT=3002
UPLOAD_DIR=./uploads
# Isi jika URL publik file berbeda dari origin aplikasi, misalnya https://files.contoh.com
PUBLIC_UPLOAD_URL=
CORS_ORIGIN=*
MAX_UPLOAD_MB=10
MAX_UPLOAD_FILES=5
